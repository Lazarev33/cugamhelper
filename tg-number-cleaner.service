[Unit]
Description=Помощник 2 смены (Telegram Bot)
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=60
TimeoutStopSec=15
User=tgnumclean
Group=tgnumclean
WorkingDirectory=/opt/tg-number-cleaner
EnvironmentFile=/etc/tg-number-cleaner/bot.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/tg-number-cleaner/.venv/bin/python /opt/tg-number-cleaner/bot.py
Restart=on-failure
RestartSec=5
UMask=0077
StateDirectory=tg-number-cleaner
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
